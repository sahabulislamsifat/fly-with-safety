generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  // Legacy values kept so existing rows stay valid. OPEN behaves as NEW, CLOSED as RESOLVED.
  OPEN
  CLOSED
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String?
  name          String?
  role          UserRole @default(CUSTOMER)
  emailVerified Boolean  @default(false)
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts                 Account[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  sessions                 Session[]
  idempotencyRecords       IdempotencyRecord[]
  flightInquiries          FlightInquiry[]
  hotelInquiries           HotelInquiry[]
  packageInquiries         PackageInquiry[]
  visaInquiries            VisaInquiry[]
  bookings                 Booking[]
  gatewayPayments          GatewayPayment[]
  identityAccount          IdentityAccount?
  identityMemberships      IdentityMembership[]
  identityAssignments      IdentityAssignment[]
  identityMfa              IdentityMfa?
  issuedIdentityInvites    IdentityInvitation[]

  @@index([email])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityProof IdentitySession?

  @@index([userId])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id              String   @id @default(cuid())
  operation       String
  principal       String
  key             String
  payloadHash     String
  referenceNumber String
  userId          String?
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([operation, principal, key])
  @@index([userId])
  @@index([referenceNumber])
}

// ─── Destinations ────────────────────────────────────────────────────────────

model Destination {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  country       String
  description   String?
  startingPrice Int           @default(0)
  image         String?
  featured      Boolean       @default(false)
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  packages Package[]

  @@index([slug])
  @@index([status, featured])
}

// ─── Packages ─────────────────────────────────────────────────────────────

model Package {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  destinationId  String
  description    String?
  price          Int           @default(0)
  durationDays   Int           @default(1)
  featuredImage  String?
  gallery        String[]      @default([])
  itinerary      Json?
  inclusions     String[]      @default([])
  exclusions     String[]      @default([])
  featured       Boolean       @default(false)
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  destination      Destination      @relation(fields: [destinationId], references: [id])
  packageInquiries PackageInquiry[]

  @@index([slug])
  @@index([destinationId])
  @@index([status, featured])
}

// ─── Visa ────────────────────────────────────────────────────────────────────

model VisaInfo {
  id             String        @id @default(cuid())
  country        String        @unique
  slug           String        @unique
  visaRequired   Boolean       @default(true)
  processingTime String?
  fee            String?
  documents      String[]      @default([])
  notes          String?
  status         ContentStatus @default(PUBLISHED)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())

  @@index([slug])
  @@index([country])
}

// ─── Inquiries ───────────────────────────────────────────────────────────────

model FlightInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  fromAirport     String
  toAirport       String
  departureDate   String
  returnDate      String?
  passengers      Int           @default(1)
  cabinClass      String        @default("economy")
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
  identityAssignments IdentityAssignment[]

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model HotelInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  destination     String
  checkIn         String
  checkOut        String
  guests          Int           @default(1)
  rooms           Int           @default(1)
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
  identityAssignments IdentityAssignment[]

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model PackageInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  packageId       String?
  packageTitle    String?
  travellers      Int           @default(1)
  travelDate      String?
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])
  identityAssignments IdentityAssignment[]

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model VisaInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  destination     String
  nationality     String
  travelPurpose   String?
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])
  identityAssignments IdentityAssignment[]

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ─── Contact ─────────────────────────────────────────────────────────────────

model ContactMessage {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  firstName       String
  lastName        String
  email           String
  phone           String?
  subject         String
  serviceType     String?
  message         String
  status          ContactStatus @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  identityAssignments IdentityAssignment[]

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ─── Testimonials ────────────────────────────────────────────────────────────

model Testimonial {
  id        String            @id @default(cuid())
  quote     String
  author    String
  role      String?
  rating    Int               @default(5)
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
}

// ─── Booking ─────────────────────────────────────────────────────────────────

enum BookingType {
  FLIGHT
  HOTEL
  PACKAGE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingModel {
  AGENCY_INQUIRY
  PROVIDER_REDIRECT
  DIRECT_API
}

model Booking {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  bookingType     BookingType   @default(FLIGHT)
  bookingModel    BookingModel  @default(AGENCY_INQUIRY)
  status          BookingStatus @default(PENDING)
  customerName    String
  customerEmail   String
  customerPhone   String?
  totalPrice      Int           @default(0)
  currency        String        @default("BDT")
  bookingDetails  Json?
  notes           String?
  userId          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User?                  @relation(fields: [userId], references: [id])
  passengers    BookingPassenger[]
  statusHistory BookingStatusHistory[]
  gatewayPayments GatewayPayment[]
  identityAssignments IdentityAssignment[]

  @@index([referenceNumber])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

// Prepared only. Explicit local schema/least-privilege approval is required before activation.
model GatewayPayment {
  id        String @id
  bookingId String
  userId    String
  requestId String
  tranId    String @unique @db.VarChar(30)
  status    String
  valId     String? @unique
  bankId    String? @unique
  dueAt     DateTime? @db.Timestamptz(6)
  state     Json
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  events    GatewayPaymentEvent[]
  refunds   GatewayRefund[]
  @@unique([userId, requestId])
  @@index([bookingId])
  @@index([dueAt])
}

model GatewayPaymentEvent {
  id        String @id
  paymentId String
  kind      String
  actor     String
  data      Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  payment   GatewayPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([paymentId, createdAt])
}

model GatewayRefund {
  id        String @id @db.VarChar(30)
  paymentId String
  requestId String
  actorId   String
  state     Json
  payment   GatewayPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([actorId, requestId])
  @@index([paymentId])
}

model BookingPassenger {
  id             String   @id @default(cuid())
  bookingId      String
  firstName      String
  lastName       String
  passengerType  String   @default("adult")
  gender         String?
  dateOfBirth    String?
  passportNumber String?
  passportExpiry String?
  nationality    String?
  createdAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  fromStatus BookingStatus
  toStatus   BookingStatus
  reason    String?
  changedBy String?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─── Notification Outbox ──────────────────────────────────────────────────────

enum NotificationStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model NotificationOutbox {
  id             String             @id @default(cuid())
  channel        String             @default("EMAIL")
  recipient      String
  subject        String
  payload        Json
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  maxAttempts    Int                @default(5)
  nextAttemptAt  DateTime           @default(now())
  processedAt    DateTime?
  error          String?
  idempotencyKey String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// Additive P5 governance. Existing users are never promoted by this schema.
enum IdentityDepartment {
  FLIGHT
  HOTEL
  VISA
  PACKAGES
  FINANCE
  SUPPORT
}

model IdentityAccount {
  userId String @id
  suspended Boolean @default(false)
  version Int @default(0)
  mfaVersion Int @default(0)
  mfaFailures Int @default(0)
  mfaBlockedUntil DateTime? @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model IdentitySession {
  sessionId String @id
  version Int
  mfaVersion Int
  mfaVerifiedAt DateTime? @db.Timestamptz(6)
  failures Int @default(0)
  blockedUntil DateTime? @db.Timestamptz(6)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model IdentityMembership {
  userId String
  department IdentityDepartment
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([userId, department])
}

model IdentityAssignment {
  id String @id
  userId String
  department IdentityDepartment
  active Boolean @default(true)
  bookingId String?
  flightInquiryId String?
  hotelInquiryId String?
  packageInquiryId String?
  visaInquiryId String?
  contactMessageId String?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  flightInquiry FlightInquiry? @relation(fields: [flightInquiryId], references: [id], onDelete: Restrict)
  hotelInquiry HotelInquiry? @relation(fields: [hotelInquiryId], references: [id], onDelete: Restrict)
  packageInquiry PackageInquiry? @relation(fields: [packageInquiryId], references: [id], onDelete: Restrict)
  visaInquiry VisaInquiry? @relation(fields: [visaInquiryId], references: [id], onDelete: Restrict)
  contactMessage ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: Restrict)
  @@unique([userId, bookingId, department])
  @@unique([userId, flightInquiryId, department])
  @@unique([userId, hotelInquiryId, department])
  @@unique([userId, packageInquiryId, department])
  @@unique([userId, visaInquiryId, department])
  @@unique([userId, contactMessageId, department])
  @@index([userId, department, active])
}

model IdentityInvitation {
  id String @id
  email String
  role UserRole
  departments IdentityDepartment[]
  tokenHash String @unique
  issuerId String
  issuerVersion Int
  expiresAt DateTime @db.Timestamptz(6)
  usedAt DateTime? @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)
  issuer User @relation(fields: [issuerId], references: [id], onDelete: Restrict)
}

model IdentityMfa {
  userId String @id
  secret String?
  pendingSecret String?
  pendingUntil DateTime? @db.Timestamptz(6)
  lastStep BigInt @default(-1)
  recoveryHashes String[]
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model IdentityAudit {
  id String @id
  actorId String
  action String
  targetId String
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([targetId, createdAt])
}

