generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContactStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String?
  name          String?
  role          UserRole @default(CUSTOMER)
  emailVerified Boolean  @default(false)
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts                 Account[]
  emailVerificationTokens  EmailVerificationToken[]
  flightInquiries          FlightInquiry[]
  hotelInquiries           HotelInquiry[]
  packageInquiries         PackageInquiry[]
  visaInquiries            VisaInquiry[]

  @@index([email])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Destinations ────────────────────────────────────────────────────────────

model Destination {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  country       String
  description   String?
  startingPrice Int           @default(0)
  image         String?
  featured      Boolean       @default(false)
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  packages Package[]

  @@index([slug])
  @@index([status, featured])
}

// ─── Packages ─────────────────────────────────────────────────────────────

model Package {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  destinationId  String
  description    String?
  price          Int           @default(0)
  durationDays   Int           @default(1)
  featuredImage  String?
  gallery        String[]      @default([])
  itinerary      Json?
  inclusions     String[]      @default([])
  exclusions     String[]      @default([])
  featured       Boolean       @default(false)
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  destination      Destination      @relation(fields: [destinationId], references: [id])
  packageInquiries PackageInquiry[]

  @@index([slug])
  @@index([destinationId])
  @@index([status, featured])
}

// ─── Visa ────────────────────────────────────────────────────────────────────

model VisaInfo {
  id             String        @id @default(cuid())
  country        String        @unique
  slug           String        @unique
  visaRequired   Boolean       @default(true)
  processingTime String?
  fee            String?
  documents      String[]      @default([])
  notes          String?
  status         ContentStatus @default(PUBLISHED)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())

  @@index([slug])
  @@index([country])
}

// ─── Inquiries ───────────────────────────────────────────────────────────────

model FlightInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  fromAirport     String
  toAirport       String
  departureDate   String
  returnDate      String?
  passengers      Int           @default(1)
  cabinClass      String        @default("economy")
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model HotelInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  destination     String
  checkIn         String
  checkOut        String
  guests          Int           @default(1)
  rooms           Int           @default(1)
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model PackageInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  packageId       String?
  packageTitle    String?
  travellers      Int           @default(1)
  travelDate      String?
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model VisaInquiry {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  userId          String?
  destination     String
  nationality     String
  travelPurpose   String?
  name            String
  email           String
  phone           String?
  notes           String?
  status          InquiryStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ─── Contact ─────────────────────────────────────────────────────────────────

model ContactMessage {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  firstName       String
  lastName        String
  email           String
  phone           String?
  subject         String
  message         String
  status          ContactStatus @default(OPEN)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([referenceNumber])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// ─── Testimonials ────────────────────────────────────────────────────────────

model Testimonial {
  id        String            @id @default(cuid())
  quote     String
  author    String
  role      String?
  rating    Int               @default(5)
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
}
