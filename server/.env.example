# Server
# PORT=5000
# NODE_ENV=development
# CORS_ORIGINS=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# Database (for future phases)
# DATABASE_URL="postgresql://user:password@localhost:5432/flywithsafe"

# JWT Configuration
# JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT_EXPIRES_IN=7d

# Google OAuth Configuration
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# SMTP Configuration
# EMAIL_DELIVERY_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=noreply@flywithsafe.com

# Controlled integration testing only. Set these outside source control.
# The database name must end in "_integration" and must not be production.
# INTEGRATION_TEST_DATABASE_URL="postgresql://.../flywithsafe_integration"
# RUN_IDEMPOTENCY_INTEGRATION=true
# EMAIL_DELIVERY_ENABLED=false

# External APIs (for future phases)
# FLIGHT_API_KEY=
# HOTEL_API_KEY=
