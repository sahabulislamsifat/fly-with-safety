# ==============================================================================
# FlyWithSafe Server Environment Variables
# ==============================================================================

# Server Environment
# Development:
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Production (Vercel deployment):
# NODE_ENV=production
# FRONTEND_URL=https://fly-with-safety.netlify.app
# API_BASE_URL=https://fly-with-safety-server.vercel.app
# CORS_ORIGINS=https://fly-with-safety.netlify.app
# GOOGLE_CALLBACK_URL=https://fly-with-safety-server.vercel.app/api/v1/auth/google/callback

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/flywithsafe"
# DIRECT_URL="postgresql://user:password@localhost:5432/flywithsafe"

# JWT Configuration (at least 32 characters in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000
REFRESH_TOKEN_EXPIRES_DAYS=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SMTP Configuration
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_EMAIL_FROM=noreply@flywithsafe.com
SMTP_EMAIL_FROM_NAME="FlyWithSafe"
SMTP_SERVICE=

# Stripe Payment
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=

# Admin seed credentials (db:seed)
ADMIN_EMAIL=admin@flywithsafe.com
ADMIN_PASSWORD=Admin@2026!ChangeMe
