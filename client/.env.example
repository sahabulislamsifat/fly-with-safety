# ==============================================================================
# FlyWithSafe Client Environment Variables
# ==============================================================================

# Local Development (client/.env or client/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local API override. If unset, frontend automatically checks localhost:5000 when viewed locally.
# NEXT_PUBLIC_LOCAL_API_BASE_URL=http://localhost:5000/api/v1

# Production Deployment (Set in Netlify Dashboard build environment)
# NEXT_PUBLIC_API_BASE_URL=https://fly-with-safety-server.vercel.app/api/v1
# NEXT_PUBLIC_SITE_URL=https://fly-with-safety.netlify.app
