# Deployed API fallback. NEXT_PUBLIC_* values are fixed when Next.js builds.
NEXT_PUBLIC_API_BASE_URL=https://fly-with-safety-server.vercel.app/api/v1

# Optional local API override. Otherwise a local frontend checks port 5000.
# NEXT_PUBLIC_LOCAL_API_BASE_URL=http://localhost:5000/api/v1

# Frontend Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
