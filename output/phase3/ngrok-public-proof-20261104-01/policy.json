{
  "on_http_request": [
    {
      "expressions": [
        "!(req.url.scheme == 'https' && req.url.host == 'russel-semisacred-elise.ngrok-free.dev' && req.method == 'POST' && req.url.raw_path in ['/api/v1/payments/sslcommerz/success', '/api/v1/payments/sslcommerz/fail', '/api/v1/payments/sslcommerz/cancel', '/api/v1/payments/sslcommerz/ipn'] && req.url.query == '')"
      ],
      "actions": [
        { "type": "custom-response", "config": { "status_code": 404, "body": "", "headers": { "content-type": "text/plain", "cache-control": "no-store" } } }
      ]
    },
    {
      "actions": [
        { "type": "remove-headers", "config": { "headers": ["x-forwarded-host", "forwarded", "x-original-url", "x-rewrite-url"] } },
        { "type": "add-headers", "config": { "headers": { "host": "phase3-callback.invalid" } } }
      ]
    }
  ]
}
